# Entorno (Desarrollo Local / Vercel Serverless)
NODE_ENV=development
PORT=3000
FRONTEND_URL=http://localhost:3000
BACKEND_URL=http://localhost:3000
API_URL=http://localhost:3000

# PostgreSQL / Supabase (Puerto 6543 Transaction Pooler recomendado para Serverless)
NODE_DATABASE_URL=
PYTHON_DATABASE_URL=
PG_POOL_MAX=2
NODE_DATABASE_SSL_REJECT_UNAUTHORIZED=false
# Producción: configure una CA y cambie el valor anterior a true.
NODE_DATABASE_SSL_CA_BASE64=
SUPABASE_URL=
SUPABASE_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Google Cloud / Vertex AI Exclusivo / GCS
GOOGLE_CLOUD_PROJECT=
GOOGLE_CLOUD_LOCATION=us-central1
GCS_BUCKET_NAME=
# En Vercel Serverless: JSON completo o Base64 de la Service Account corporativa de GCP
GOOGLE_SERVICE_ACCOUNT_JSON=
# Solo desarrollo local con archivo físico (ignorado en git)
GOOGLE_APPLICATION_CREDENTIALS=service-account-key.json
# Modelos estándar en Vertex AI
VERTEX_MODEL_PRIMARY=gemini-3.6-flash-lite
VERTEX_MODEL_FALLBACK=gemini-3.6-flash

# Servicios internos
ML_SERVICE_TOKEN=
INTERNAL_API_TOKEN=
SECURE_QUIZ_SESSIONS_ENABLED=false

# Pagos (Exclusivo Mercado Pago)
MP_ACCESS_TOKEN=
MP_WEBHOOK_SECRET=

# RAG Normativo (Tutor IA - Pinecone)
PINECONE_API_KEY=
PINECONE_HOST=
