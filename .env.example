# Entorno
NODE_ENV=development
PORT=3000
FRONTEND_URL=http://localhost:3000
BACKEND_URL=http://localhost:3000
API_URL=http://localhost:3000

# PostgreSQL / Supabase
NODE_DATABASE_URL=
PYTHON_DATABASE_URL=
NODE_DATABASE_SSL_REJECT_UNAUTHORIZED=false
# Producción: configure una CA y cambie el valor anterior a true.
NODE_DATABASE_SSL_CA_BASE64=
SUPABASE_URL=
SUPABASE_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Google Cloud / Vertex AI / GCS
GOOGLE_CLOUD_PROJECT=
GOOGLE_CLOUD_LOCATION=us-central1
GCS_BUCKET_NAME=
# Solo desarrollo local. En producción se recomienda ADC y dejar esta variable vacía.
GOOGLE_APPLICATION_CREDENTIALS=service-account-key.json
GEMINI_API_KEY=

# Servicios internos
ML_SERVICE_TOKEN=
INTERNAL_API_TOKEN=
SECURE_QUIZ_SESSIONS_ENABLED=false

# Pagos
MP_ACCESS_TOKEN=
MP_WEBHOOK_SECRET=

# RAG
PINECONE_API_KEY=
PINECONE_HOST=
